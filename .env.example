# Copia este archivo a .env y ajústalo. El servidor lo lee al arrancar (si existe).
# Las variables ya definidas en el entorno tienen prioridad sobre las de .env.
# .env está en .gitignore: nunca subas tus credenciales.

# Vacío = modo memoria (los datos se pierden al reiniciar).
DATABASE_URL=postgres://siem:siem@localhost:5433/siem?sslmode=disable

PORT=8080

# Detector de fuerza bruta: N logins fallidos dentro de la ventana disparan una alerta.
BRUTEFORCE_THRESHOLD=5
BRUTEFORCE_WINDOW=1m
BRUTEFORCE_COOLDOWN=5m

# Posible cuenta comprometida: login exitoso tras N fallos desde la misma IP dentro de la ventana.
COMPROMISE_THRESHOLD=5
COMPROMISE_WINDOW=10m

# Escaneo: N respuestas 404 de nginx a una IP dentro de la ventana.
SCAN_THRESHOLD=20
SCAN_WINDOW=1m
SCAN_COOLDOWN=10m

# Notificaciones por Telegram (las dos o ninguna). Ver README, sección "Notificaciones".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clave para POST /events (cabecera "Authorization: Bearer <clave>"), mínimo 32 caracteres.
# Vacía = cualquiera puede enviar eventos: solo para desarrollo local.
# Genera una con: openssl rand -hex 32
INGEST_API_KEY=

# Rate limit por IP (token bucket): peticiones por segundo y tamaño de la ráfaga.
# RATE_LIMIT_RPS=0 lo desactiva. /healthz, /readyz y /metrics no cuentan.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=50
# true solo detrás de un proxy propio (Caddy, nginx): la IP se toma de X-Forwarded-For.
TRUST_PROXY=false
