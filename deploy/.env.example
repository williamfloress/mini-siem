# Configuración de producción. setup-vps.sh la copia a /opt/mini-siem/.env (modo 600).
# Además de estas variables se aceptan todas las del .env.example de la raíz
# (umbrales de las reglas, rate limit...).

# Subdominio con un registro A (y AAAA si hay IPv6) apuntando al VPS.
SIEM_DOMAIN=siem.example.com

# Etiqueta de la imagen en ghcr.io. La actualiza deploy.sh en cada despliegue.
IMAGE_TAG=latest

# openssl rand -hex 24   (hexadecimal: va dentro de una URL sin escapar nada)
POSTGRES_PASSWORD=

# openssl rand -hex 32   (la misma clave va en /etc/mini-siem/agent.env)
INGEST_API_KEY=

# Acceso al panel. El hash se genera con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-contraseña'
# Va entre comillas simples: el hash tiene "$" y, sin ellas, compose los interpreta.
PANEL_USER=admin
PANEL_PASSWORD_HASH=''

# Opcional: alertas por Telegram (ver README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
