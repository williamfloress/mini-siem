# Configuración del agente. setup-vps.sh la copia a /etc/mini-siem/agent.env (modo 600,
# solo root: systemd la lee antes de arrancar el agente con un usuario sin privilegios).

# URL pública del SIEM. Con https, la API key viaja cifrada.
SIEM_URL=https://siem.example.com

# La misma INGEST_API_KEY que /opt/mini-siem/.env.
INGEST_API_KEY=

# Log a seguir. En Debian/Ubuntu con rsyslog es /var/log/auth.log.
#AUTH_LOG=/var/log/auth.log
