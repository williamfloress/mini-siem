[Unit]
Description=mini-siem agent: envía los logins SSH de auth.log al SIEM
Documentation=https://github.com/williamfloress/mini-siem
After=network-online.target rsyslog.service
Wants=network-online.target

[Service]
ExecStart=/opt/mini-siem/bin/mini-siem-agent
EnvironmentFile=/etc/mini-siem/agent.env
Restart=on-failure
RestartSec=5s

# Usuario temporal creado por systemd, sin privilegios. El grupo adm es el que puede
# leer /var/log/auth.log en Debian y Ubuntu.
DynamicUser=yes
SupplementaryGroups=adm

# Endurecimiento: el agente solo necesita leer un archivo y hablar HTTPS.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
